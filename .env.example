
# ---------------------------------------------------------------
# Smart Receipt — ortam degiskenleri sablonu
# Bu dosyayi ".env.local" olarak kopyalayip degerleri doldur:
#   cp .env.example .env.local
# .env.local git'e ASLA gonderilmez.
# ---------------------------------------------------------------

# fal.ai API anahtari — https://fal.ai/dashboard/keys
# Sadece sunucu tarafinda kullanilir, tarayiciya sizmaz.
FAL_KEY=

# Google Apps Script web app URL'si (Deploy > New deployment > Web app)
# Ornek: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL=

# (Istege bagli) Google Sheet dosyasinin adresi. Doldurulursa Ayarlar
# sayfasinda "Sheet'i ac" kisayolu gorunur. NEXT_PUBLIC_ oneki tarayiciya
# acilir — buraya gizli bir deger yazma.
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# (Istege bagli) Fis gorsellerinin durdugu Drive klasoru. Ayarlar sayfasindan
# da girilebilir; buradaki deger yalnizca baslangic degeri olur.
NEXT_PUBLIC_GOOGLE_DRIVE_URL=
